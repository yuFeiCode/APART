402 
protected
 void 
	$fireAdvisory
(
ConnectionContext
 
context
, 
ActiveMQTopic
 
topic
, 
Command
 
command
, 
ConsumerId
 
targetConsumerId
, 
ActiveMQMessage
 
advisoryMessage
) 
throws
 
Exception
 {

403 if (
	`getBrokerService
().
	`isStarted
()) {

405 
advisoryMessage
.
	`setStringProperty
(
AdvisorySupport
.
MSG_PROPERTY_ORIGIN_BROKER_NAME
, 
	`getBrokerName
());

406 
String
 
id
 = 
	`getBrokerId
() != 
null
 ? getBrokerId().
	`getValue
() : "NOT_SET";

407 
advisoryMessage
.
	`setStringProperty
(
AdvisorySupport
.
MSG_PROPERTY_ORIGIN_BROKER_ID
, 
id
);

409 
String
[] 
uris
 = 
	`getBrokerService
().
	`getTransportConnectorURIs
();

410 
String
 
url
 = 
	`getBrokerService
().
	`getVmConnectorURI
().
	`toString
();

411 if (
uris
 != 
null
 && uris.
length
 > 0) {

412 
url
 = 
uris
[0];

414 
advisoryMessage
.
	`setStringProperty
(
AdvisorySupport
.
MSG_PROPERTY_ORIGIN_BROKER_URL
, 
url
);

417 
advisoryMessage
.
	`setDataStructure
(
command
);

418 
advisoryMessage
.
	`setPersistent
(
false
);

419 
advisoryMessage
.
	`setType
(
AdvisorySupport
.
ADIVSORY_MESSAGE_TYPE
);

420 
advisoryMessage
.
	`setMessageId
(
new
 
	`MessageId
(
advisoryProducerId
, 
messageIdGenerator
.
	`getNextSequenceId
()));

421 
advisoryMessage
.
	`setTargetConsumerId
(
targetConsumerId
);

422 
advisoryMessage
.
	`setDestination
(
topic
);

423 
advisoryMessage
.
	`setResponseRequired
(
false
);

424 
advisoryMessage
.
	`setProducerId
(
advisoryProducerId
);

425 
boolean
 
originalFlowControl
 = 
context
.
	`isProducerFlowControl
();

426 
final
 
ProducerBrokerExchange
 
producerExchange
 = 
new
 
	`ProducerBrokerExchange
();

427 
producerExchange
.
	`setConnectionContext
(
context
);

428 
producerExchange
.
	`setMutable
(
true
);

429 
producerExchange
.
	`setProducerState
(
new
 
	`ProducerState
(new 
	`ProducerInfo
()));

430 
try
 {

431 
context
.
	`setProducerFlowControl
(
false
);

432 
next
.
	`send
(
producerExchange
, 
advisoryMessage
);

433 } 
finally
 {

434 
context
.
	`setProducerFlowControl
(
originalFlowControl
);

437 
	}
}

